#!/bin/bash
# Mock wlr-randr: mirrors real wlr-randr mode checks and labwc NOOP-1 cleanup.

set -euo pipefail

STATE_FILE="${USM_MOCK_STATE_DIR}/wlr.env"
# shellcheck disable=SC1090
source "$STATE_FILE"

if (( $# > 0 )); then
  printf "wlr-randr %s\n" "$*" >> "$USM_MOCK_LOG"
fi

if [[ "${WLR_CONNECT_FAIL:-false}" == "true" ]]; then
  printf "failed to connect to display\n" >&2
  exit 1
fi

_save_var() {
  local key="$1"
  local val="$2"
  if grep -q "^${key}=" "$STATE_FILE"; then
    sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$STATE_FILE"
  else
    printf '%s="%s"\n' "$key" "$val" >> "$STATE_FILE"
  fi
}

_print_output() {
  local name="$1"
  local enabled="$2"
  local modes="$3"
  local preferred="${4:-}"
  printf '%s "Mock %s"\n' "$name" "$name"
  printf "  Enabled: %s\n" "$enabled"
  if [[ -n "$modes" ]]; then
    printf "  Modes:\n"
    local m
    for m in $modes; do
      local tag=""
      if [[ "$m" == "$preferred" && "$enabled" == "yes" ]]; then
        tag=" (preferred, current)"
      elif [[ "$m" == "$preferred" ]]; then
        tag=" (preferred)"
      elif [[ "$enabled" == "yes" ]]; then
        tag=" (current)"
      fi
      printf "    %s px, 60.000000 Hz%s\n" "$m" "$tag"
    done
  fi
}

if (( $# == 0 )); then
  if [[ "${WLR_HAS_HDMI:-false}" == "true" ]]; then
    _print_output "HDMI-A-1" "${WLR_HDMI_ENABLED:-no}" \
      "${WLR_HDMI_MODES:-}" "${WLR_HDMI_PREFERRED:-}"
  fi
  if [[ "${WLR_HAS_NOOP:-false}" == "true" ]]; then
    _print_output "NOOP-1" "yes" "1920x1080" "1920x1080"
  fi
  if [[ "${WLR_HAS_DSI:-false}" == "true" ]]; then
    _print_output "DSI-2" "${WLR_DSI_ENABLED:-no}" \
      "${WLR_DSI_MODES:-720x1280}" "720x1280"
  fi
  exit 0
fi

cur_out=""
new_dsi="${WLR_DSI_ENABLED:-no}"
new_hdmi="${WLR_HDMI_ENABLED:-no}"
new_noop="${WLR_HAS_NOOP:-false}"
new_hdmi_mode="${WLR_HDMI_CURRENT_MODE:-${WLR_HDMI_PREFERRED:-}}"
hdmi_mode_set=false
req_dsi_on=false
req_dsi_off=false

while (( $# > 0 )); do
  case "$1" in
    --output)
      shift
      cur_out="${1:-}"
      out_exists=false
      if [[ "$cur_out" == "DSI-2" && "${WLR_HAS_DSI:-false}" == "true" ]]; then
        out_exists=true
      elif [[ "$cur_out" == "HDMI-A-1" && \
              "${WLR_HAS_HDMI:-false}" == "true" ]]; then
        out_exists=true
      elif [[ "$cur_out" == "NOOP-1" && \
              "${WLR_HAS_NOOP:-false}" == "true" ]]; then
        out_exists=true
      fi
      if [[ "$out_exists" != "true" ]]; then
        printf "unknown output %s\n" "$cur_out" >&2
        exit 1
      fi
      ;;
    --on)
      if [[ "$cur_out" == "DSI-2" ]]; then
        new_dsi="yes"
        req_dsi_on=true
      fi
      if [[ "$cur_out" == "HDMI-A-1" ]]; then
        if [[ "${WLR_HDMI_ENABLED:-no}" != "yes" && \
              "$hdmi_mode_set" != "true" ]]; then
          if [[ -n "${WLR_HDMI_PREFERRED:-}" ]]; then
            new_hdmi_mode="$WLR_HDMI_PREFERRED"
          else
            new_hdmi_mode="${WLR_HDMI_MODES%% *}"
          fi
        fi
        new_hdmi="yes"
      fi
      ;;
    --off)
      if [[ "$cur_out" == "DSI-2" ]]; then
        new_dsi="no"
        req_dsi_off=true
      fi
      [[ "$cur_out" == "HDMI-A-1" ]] && new_hdmi="no"
      [[ "$cur_out" == "NOOP-1" ]] && new_noop="false"
      ;;
    --preferred)
      if [[ "$cur_out" == "HDMI-A-1" ]]; then
        if [[ -z "${WLR_HDMI_PREFERRED:-}" ]]; then
          printf "no preferred mode found\n" >&2
          exit 1
        fi
        new_hdmi_mode="$WLR_HDMI_PREFERRED"
        hdmi_mode_set=true
      fi
      ;;
    --mode)
      shift
      req_mode="${1:-}"
      req_res="${req_mode%%@*}"
      avail=""
      [[ "$cur_out" == "DSI-2" ]] && avail="${WLR_DSI_MODES:-}"
      [[ "$cur_out" == "HDMI-A-1" ]] && avail="${WLR_HDMI_MODES:-}"
      found=false
      for m in $avail; do
        if [[ "$m" == "$req_res" ]]; then
          found=true
          break
        fi
      done
      if [[ "$found" != "true" ]]; then
        printf "unknown mode: %s\n" "$req_mode" >&2
        exit 1
      fi
      if [[ "$cur_out" == "HDMI-A-1" ]]; then
        new_hdmi_mode="$req_res"
        hdmi_mode_set=true
      fi
      ;;
    --transform|--pos|--scale)
      shift
      ;;
    *)
      ;;
  esac
  shift || true
done

if [[ "${WLR_CANCEL_APPLY:-false}" == "true" ]]; then
  printf "configuration cancelled, please try again\n" >&2
  exit 1
fi

if [[ "${WLR_FAIL_APPLY:-false}" == "true" ]]; then
  printf "failed to apply configuration\n" >&2
  exit 1
fi

# Mirror RPi libliftoff0 0x333c permanent CRTC deadlock after out-of-band
# DSI DRM status or fb0/blank sysfs writes.
if [[ "$req_dsi_on" == "true" && \
      -f "${USM_MOCK_STATE_DIR}/dsi_drm_poisoned" ]]; then
  printf "failed to apply configuration\n" >&2
  exit 1
fi

_save_var "WLR_DSI_ENABLED" "$new_dsi"
_save_var "WLR_HDMI_ENABLED" "$new_hdmi"
_save_var "WLR_HAS_NOOP" "$new_noop"
_save_var "WLR_HDMI_CURRENT_MODE" "$new_hdmi_mode"
# Mirror panel-cwu50 kernel driver: automatically toggles bl_power on DSI
# enable/disable without modifying user brightness.
bl_power_file="${USM_SYSFS_ROOT}/class/backlight/backlight@0/bl_power"
if [[ -f "$bl_power_file" ]]; then
  if [[ "$req_dsi_off" == "true" ]]; then
    printf "4\n" > "$bl_power_file"
  elif [[ "$req_dsi_on" == "true" ]]; then
    printf "0\n" > "$bl_power_file"
  fi
fi
# Real wlr-randr commits all enabled heads, re-enabling HDMI DPMS to on.
if [[ "$new_hdmi" == "yes" ]]; then
  _save_var "WLR_HDMI_POWER" "on"
fi
exit 0
