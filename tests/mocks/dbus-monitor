#!/bin/bash
# Mock dbus-monitor: streams synthetic logind PrepareForSleep events.

set -euo pipefail

printf "dbus-monitor %s\n" "$*" >> "$USM_MOCK_LOG"
QUEUE="${USM_MOCK_STATE_DIR}/dbus.events"
if [[ -f "$QUEUE" ]]; then
  while IFS= read -r line; do
    if [[ "$line" =~ ^SLEEP:([0-9.]+)$ ]]; then
      sleep "${BASH_REMATCH[1]}"
    else
      printf "%s\n" "$line"
    fi
  done < "$QUEUE"
fi
exit 0
