#!/bin/bash
# Mock pgrep: sandbox-scoped process check (never inspects host processes).

set -euo pipefail

if [[ "$*" == *"swayidle"* ]]; then
  # shellcheck disable=SC1090,SC1091
  source "${USM_MOCK_STATE_DIR}/swayidle.env"
  if [[ "${SWAYIDLE_RUNNING:-0}" == "1" ]]; then
    printf "99999\n"
    exit 0
  fi
  exit 1
fi

if [[ "$*" == *"kanshi"* ]]; then
  if [[ -f "${USM_MOCK_STATE_DIR}/kanshi.env" ]]; then
    # shellcheck disable=SC1090,SC1091
    source "${USM_MOCK_STATE_DIR}/kanshi.env"
    if [[ "${KANSHI_RUNNING:-0}" == "1" ]]; then
      printf "88888\n"
      exit 0
    fi
  fi
  exit 1
fi

exit 1
