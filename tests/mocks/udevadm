#!/bin/bash
# Mock udevadm: streams synthetic DRM events from sandbox queue file.

set -euo pipefail

printf "udevadm %s\n" "$*" >> "$USM_MOCK_LOG"
QUEUE="${USM_MOCK_STATE_DIR}/udev.events"
if [[ -f "$QUEUE" ]]; then
  while IFS= read -r line; do
    if [[ "$line" =~ ^SLEEP:([0-9.]+)$ ]]; then
      sleep "${BASH_REMATCH[1]}"
    else
      printf "%s\n" "$line"
    fi
  done < "$QUEUE"
fi
exit 0
