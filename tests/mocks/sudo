#!/bin/bash
# Mock sudo: passthrough and poison detector for out-of-band DSI DRM/fb0 writes.

set -euo pipefail

printf "sudo %s\n" "$*" >> "$USM_MOCK_LOG"
rc=0
"$@" || rc=$?
if [[ "$rc" -eq 0 && \
      ("$*" == *"DSI-2/status"* || "$*" == *"fb0/blank"*) ]]; then
  printf "1\n" > "$USM_MOCK_STATE_DIR/dsi_drm_poisoned"
fi
exit "$rc"
